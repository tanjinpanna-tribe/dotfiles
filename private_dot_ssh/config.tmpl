# Includes must precede any Host block.
Include ~/.orbstack/ssh/config
# Untracked, per-machine hosts (client keys etc.)
Include ~/.ssh/config.local

Host *
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
{{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
{{- end }}

Host github.com
  HostName github.com
  User git

# Enable agent forwarding only for trusted remote development hosts.
# Example:
# Host devpod-* codespace-*
#   ForwardAgent yes
