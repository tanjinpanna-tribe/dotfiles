{{- $remote := or (env "CODESPACES" | not | not) (env "SSH_CONNECTION" | not | not) (env "KUBERNETES_SERVICE_HOST" | not | not) (env "container" | not | not) (env "REMOTE_CONTAINERS" | not | not) (stat "/.dockerenv" | not | not) -}}
# enable zsh history
HISTFILE="$HOME/.zsh_history"
HISTSIZE=60000
SAVEHIST=50000

setopt HIST_IGNORE_SPACE # do not save a command if it starts with a space
setopt HIST_IGNORE_DUPS  # do not save duplicate commands

# solve weird extra character issues when auto completing
export LANG="en_US.UTF-8"

# add user local completion folder to fpath
fpath+=(~/.zsh/completion)

if [[ -d $HOME/.local/bin ]] ; then 
  export PATH=$HOME/.local/bin:$PATH
fi 

if [[ -d $HOME/.krew ]] ; then
  export PATH=$HOME/.krew/bin:$PATH
fi

# edit PATH
{{ if and .chezmoi.osRelease (eq .chezmoi.osRelease.id "bazzite") -}}
export PATH=$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:$PATH
{{- end}}

{{if not .remote -}}
# pick up macOS launchd ssh-agent socket
if [ -z "${SSH_AUTH_SOCK:-}" ] && command -v launchctl >/dev/null 2>&1; then
  export SSH_AUTH_SOCK="$(launchctl getenv SSH_AUTH_SOCK)"
fi

# setup gpg-agent ssh
if command -v gpgconf >/dev/null 2>&1; then
  unset SSH_AGENT_PID
  if [ "${gnupg_SSH_AUTH_SOCK_by:-0}" -ne $$ ]; then
    export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
  fi
fi
{{- end}}

# enable brew if found on linux
if [ -f /home/linuxbrew/.linuxbrew/bin/brew ] ; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

if command -v mise > /dev/null ; then
  eval "$(mise activate zsh)"
fi

export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"

autoload -Uz compinit && compinit

# (neo)vim
if command -v nvim > /dev/null ; then
  export EDITOR="nvim"
  export VISUAL="nvim"
elif command -v vim > /dev/null ; then
  export EDITOR="vim"
  export VISUAL="vim"
fi

if command -v lsd > /dev/null ; then
  alias ls="lsd"
  alias ll="ls -lgh"
  alias la='ls -a'
  alias lla='ls -lgha'
  alias lt='ls --tree'
fi

# enable zsh vi-mode
bindkey -v
export KEYTIMEOUT=1 # make switching between modes faster
bindkey -M viins '^[^?' backward-kill-word  # Alt-Backspace (most terminals send ESC+DEL)
bindkey -M viins '^[^H' backward-kill-word  # Alt-Backspace (some terminals send ESC+BS)
bindkey -M viins '^[[1;3D' backward-word    # Alt-Left (most terminals send ESC+[1;3D)
bindkey -M viins '^[[1;3C' forward-word     # Alt-Right (most terminals send ESC+[1;3C)
bindkey -M viins '^[b' backward-word        # Alt-Left (some terminals send ESC+b)
bindkey -M viins '^[f' forward-word         # Alt-Right (some terminals send ESC+f)

# enable the starship prompt
if command -v starship > /dev/null ; then
  eval "$(starship init zsh)"
fi

# enable fzf autocompletion and key-bindings if found
if command -v fzf > /dev/null ; then
  source <(fzf --zsh)
fi

if command -v kubectl > /dev/null ; then
  source <(kubectl completion zsh)
  alias k="kubectl"
fi

if command -v herdr > /dev/null ; then
  source <(herdr completion zsh)
fi

# if zoxide is installed, enable it
if command -v zoxide > /dev/null ; then
  eval "$(zoxide init zsh)"
  alias cd="z"
fi

if command -v direnv > /dev/null ; then
  eval "$(direnv hook zsh)"
fi

# some nice functions and aliases

## Clean up stale Claude Code worktrees (.claude/worktrees/*) and prune merged
## branches. Claude locks its session worktrees: a lock whose session pid is gone
## gets dropped automatically, one a live session still holds needs --evict (which
## unlocks rather than `remove -f -f`, so the dirty check below still applies).
## Worktrees with uncommitted/untracked changes are skipped unless --force.
##   worktree-clean            # remove clean, unlocked worktrees, then `gt sync`
##   worktree-clean -n         # show what would be removed
##   worktree-clean --evict    # also remove worktrees a live session has locked
##   worktree-clean --force    # also remove dirty worktrees (rm uncommitted work)
worktree-clean() {
  local force="" dry="" evict=""
  for arg in "$@"; do
    case "$arg" in
      --force|-f) force="--force" ;;
      --evict|-e) evict=1 ;;
      --dry-run|-n) dry=1 ;;
      *) echo "worktree-clean: unknown option '$arg'" >&2; return 2 ;;
    esac
  done

  git rev-parse --show-toplevel > /dev/null 2>&1 || {
    echo "worktree-clean: not inside a git repository" >&2; return 1
  }

  local removed=0 skipped=0 wt lock pid err br main open_heads gh_ok=1
  main=$(git worktree list --porcelain | awk '/^worktree /{ print substr($0, 10); exit }')
  open_heads=$(gh pr list --state open --author @me --limit 200 --json headRefName -q '.[].headRefName' 2>/dev/null) || gh_ok=""
  open_heads=$'\n'"$open_heads"$'\n'
  while IFS=$'\t' read -r wt lock; do
    [[ "$wt" == "$main" ]] && continue
    if [[ "$wt" != */.claude/worktrees/* ]]; then
      # Hand-made worktrees go only once their branch has no open PR (or HEAD is detached).
      br=$(git -C "$wt" branch --show-current 2>/dev/null)
      if [[ -n "$br" && ( -z "$gh_ok" || "$open_heads" == *$'\n'"$br"$'\n'* ) ]]; then
        if [[ -n "$gh_ok" ]]; then err="open PR on $br"; else err="gh unavailable, can't check PRs"; fi
        echo "skipped ($err): $wt" >&2
        skipped=$((skipped + 1))
        continue
      fi
    fi

    if [[ -n "$lock" ]]; then
      # Claude's lock reason carries the session pid; only an unambiguously dead one
      # is safe to unlock. Pid reuse just costs an extra skip.
      pid="${lock##*pid }"; pid="${pid%%[^0-9]*}"
      if [[ -z "$evict" ]] && { [[ -z "$pid" ]] || kill -0 "$pid" 2>/dev/null; }; then
        echo "skipped (locked${pid:+ by live session, pid $pid} — re-run with --evict): $wt" >&2
        skipped=$((skipped + 1))
        continue
      fi
      [[ -n "$dry" ]] || git worktree unlock "$wt" 2>/dev/null
    fi

    if [[ -n "$dry" ]]; then
      if [[ -z "$force" && -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]]; then
        echo "skipped (dirty — add --force): $wt" >&2
        skipped=$((skipped + 1))
        continue
      fi
      echo "would remove:${lock:+ (unlocking)} $wt"
      removed=$((removed + 1))
      continue
    fi

    if err=$(git worktree remove $force "$wt" 2>&1); then
      echo "removed: $wt"
      removed=$((removed + 1))
    else
      echo "skipped: $wt — ${err#fatal: }" >&2
      skipped=$((skipped + 1))
    fi
  done < <(git worktree list --porcelain | awk '
    /^worktree /{ path = substr($0, 10); lock = "" }
    /^locked/   { lock = (length($0) > 7 ? substr($0, 8) : "locked") }
    /^$/        { if (path != "") print path "\t" lock; path = "" }
    END         { if (path != "") print path "\t" lock }')

  if [[ -n "$dry" ]]; then
    echo "dry-run: $removed would be removed, $skipped skipped"
    return 0
  fi

  echo "worktree-clean: $removed removed, $skipped skipped"
  git worktree prune                              # reap any leftover admin entries
  if command -v gt > /dev/null; then
    echo "running gt sync to prune merged branches..."
    gt sync
  fi
}

## use bat instead of cat 
if command -v bat > /dev/null ; then
  alias cat="bat"
fi

## bat on debian based systems is batcat. Fix that.
if command -v batcat > /dev/null ; then
  alias cat="batcat"
fi

if command -v lazygit > /dev/null ; then
  alias lg="lazygit"
fi

if command -v dagger > /dev/null ; then 
  export DAGGER_NO_NAG=1
fi

if [[ -d .zsh/zsh-autosuggestions ]] ; then
  source .zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# syntax highlighting needs to be at the end because of reasons
if [[ -d .zsh/zsh-syntax-highlighting ]] ; then
  source .zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# Added by TKS CLI installer
export PATH="$HOME/.tks/bin:$PATH"

alias history='fc -l 1'

# opencode
export PATH=$HOME/.opencode/bin:$PATH
